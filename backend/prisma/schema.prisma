// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  compilerBuild = "fast"
}

datasource db {
  provider = "postgresql"
}

enum Estado {
  activo
  desactivo
}

model Usuario {
  id         Int       @id @default(autoincrement())
  nombre     String
  a_paterno  String?
  a_materno  String?
  ci         String?
  email      String    @unique
  password   String
  foto       String?
  hash_key   String?
  hash_expiry String?
  estado      Estado    @default(activo) // enum('activo','desactivo') -> prisma enum opcional

  roles      RolUsuario[]
}

model Role {
  id    Int    @id @default(autoincrement())
  rol   String
  users RolUsuario[]
  permisos PermisoRol[]
}

model Permiso {
  id          Int    @id @default(autoincrement())
  permiso     String
  descripcion String
  roles       PermisoRol[]
}

// Relación muchos a muchos: Usuario <-> Rol
model RolUsuario {
  user_id Int
  rol_id  Int

  user Usuario @relation(fields: [user_id], references: [id])
  rol  Role @relation(fields: [rol_id], references: [id])

  @@id([user_id, rol_id])
}

// Relación muchos a muchos: Rol <-> Permiso
model PermisoRol {
  rol_id     Int
  permiso_id Int

  rol     Role    @relation(fields: [rol_id], references: [id])
  permiso Permiso @relation(fields: [permiso_id], references: [id])

  @@id([rol_id, permiso_id])
}
